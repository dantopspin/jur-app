# Copy to .env and fill in. These are public client keys (safe to ship in the app).
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# RevenueCat → Project → API keys (the public SDK keys, one per store)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_XXXXXXXXXXXXXXXX
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_XXXXXXXXXXXXXXXX

# Google sign-in (optional; the button is hidden when empty)
# Google Cloud Console → APIs & Services → Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YYYYYYYY.apps.googleusercontent.com

# Shown in Settings
EXPO_PUBLIC_PRIVACY_URL=https://qadam.app/privacy
EXPO_PUBLIC_TERMS_URL=https://qadam.app/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@qadam.app

# Offline events, clubs and wristbands. Off for the app-only launch; "on" brings back the Events tab.
EXPO_PUBLIC_EVENTS=off
