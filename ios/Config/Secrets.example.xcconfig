// Copy to Secrets.xcconfig and fill in. SITE_HOST and SUPPORT_EMAIL are placeholders until the domain is bought. (xcconfig treats "//" as a comment, so hosts have no https://)
JUR_TEAM_ID = ABCDE12345
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key
REVENUECAT_IOS_KEY = appl_xxxxxxxxxxxxxxxx
SITE_HOST = jur.kz
SUPPORT_EMAIL = support@jur.kz
// on = user-created events, Tonight, check-in and event badges
JUR_EVENTS = on
