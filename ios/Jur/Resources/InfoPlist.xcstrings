    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take your verification selfie and photos for your profile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера нужна для селфи-проверки и фото профиля."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера растау селфиі мен профиль фотолары үшін керек."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record voice messages in chats."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон нужен для голосовых сообщений в чатах."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон чаттағы дауыстық хабарламалар үшін керек."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos for your profile and chats."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите фото для профиля и чатов."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль мен чаттар үшін фото таңдаңыз."
          }
        }
      }
    }
