    "safety.footerDevice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone also checks photos for nudity on the device and always blurs those. Nothing is sent anywhere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone также проверяет фото на обнажённость прямо на устройстве и всегда размывает такие. Ничего никуда не отправляется."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone фотоларды құрылғының өзінде тексеріп, жалаңаш суреттерді әрқашан бұлыңғырлайды. Ештеңе ешқайда жіберілмейді."
          }
        }
      }
