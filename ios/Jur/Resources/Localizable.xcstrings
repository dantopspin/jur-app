    "clubs.applyIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us about your club. We reply within two days; once approved you can post events and get the host kit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите о клубе. Ответим в течение двух дней; после одобрения сможете публиковать события и получите набор организатора."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клубыңыз туралы айтыңыз. Екі күн ішінде жауап береміз; мақұлданған соң іс-шара жариялап, ұйымдастырушы жинағын аласыз."
          }
        }
      }
    },
