            "state": "translated",
            "value": "Баптаулардан контактілерге рұқсат беріңіз."
          }
        }
      }
    },
    "contacts.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. These people won’t see you, and you won’t see them."
          }
