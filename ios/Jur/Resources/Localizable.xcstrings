    "contacts.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose to hide from people in your phone’s contacts — and hide them from you. Numbers and emails are turned into one-way codes on your phone; we never store the contacts themselves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скройтесь от людей из контактов телефона — и скройте их от себя. Номера и почты превращаются в односторонние коды прямо на телефоне; сами контакты мы не храним."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон контактілеріндегі адамдардан жасырыныңыз — оларды да сізден жасырамыз. Нөмірлер мен поштаға телефонда бір жақты кодқа айналады; контактілердің өзін сақтамаймыз."
          }
        }
      }
    },
    "contacts.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide my contacts"
