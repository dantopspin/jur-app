    "flow.notifySub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll tell you when someone likes you back, writes to you, or an event you joined is about to start. Nothing else."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщим, когда вам ответят взаимностью, напишут или скоро начнётся ваше событие. И ничего больше."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біреу сізді ұнатқанда, жазғанда немесе іс-шараңыз басталар алдында хабарлаймыз. Басқа ештеңе жоқ."
          }
        }
      }
    },
