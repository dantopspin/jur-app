    "me2.tip5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something feels wrong? Open their profile, tap ⋯ and choose Report. They won't know it was you."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то не так? Откройте профиль, нажмите ⋯ и выберите «Пожаловаться». Человек не узнает, что это вы."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірдеңе дұрыс емес пе? Профилін ашып, ⋯ басып, «Шағымдану» таңдаңыз. Ол сіз екеніңізді білмейді."
          }
        }
