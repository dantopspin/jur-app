    "verify.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a selfie making a thumbs-up. A moderator compares it with your photos, then you get the Verified badge. The selfie is never shown to anyone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте селфи с поднятым большим пальцем. Модератор сравнит его с вашими фото — и вы получите значок «Проверен». Селфи никто не увидит."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бас бармақты көтеріп селфи түсіріңіз. Модератор оны фотоларыңызбен салыстырады, сосын «Тексерілген» белгісін аласыз. Селфиді ешкім көрмейді."
          }
        }
      }
    },
