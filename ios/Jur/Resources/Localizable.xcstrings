        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть мои контакты"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контактілерімді жасыру"
          }
        }
      }
    },
    "contacts.denied": {
